<?xml version="1.0" encoding="UTF-8"?>
<!-- Instalador .msi do medidor-de-uso. Gerar com instalador\gerar-msi.cmd (WiX 3.14). -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="Medidor de uso para Claude Code" Language="1046" Codepage="1252"
           Version="$(var.Versao)" Manufacturer="Wercely"
           UpgradeCode="6B1F0E2A-6C3D-4E8B-9C47-2D5A1F8E7B31">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perUser"
             Description="Instala o plugin medidor-de-uso no Claude Code" />
    <MajorUpgrade DowngradeErrorMessage="Uma versao mais nova do Medidor de uso ja esta instalada." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="icone" SourceFile="icone.ico" />
    <Property Id="ARPPRODUCTICON" Value="icone" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/wercelyduarte/medidor-de-uso" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="INSTALLFOLDER" Name="MedidorDeUso" />
      </Directory>
    </Directory>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="Arquivos" Guid="A3C5E7F9-1B2D-4F60-8A9C-0E1F2A3B4C5D">
        <File Id="instalar.ps1" Source="instalar.ps1" />
        <RemoveFolder Id="RemoverPasta" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\Wercely\MedidorDeUso" Name="instalado" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="Principal" Title="Medidor de uso" Level="1">
      <ComponentRef Id="Arquivos" />
    </Feature>

    <!-- Depois de copiar o script, roda-o como o proprio usuario para instalar o plugin. -->
    <CustomAction Id="InstalarPlugin" Directory="INSTALLFOLDER" Execute="deferred" Impersonate="yes" Return="ignore"
                  ExeCommand="powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File &quot;[INSTALLFOLDER]instalar.ps1&quot;" />
    <CustomAction Id="DesinstalarPlugin" Directory="INSTALLFOLDER" Execute="deferred" Impersonate="yes" Return="ignore"
                  ExeCommand="powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File &quot;[INSTALLFOLDER]instalar.ps1&quot; -Desinstalar" />
    <InstallExecuteSequence>
      <Custom Action="DesinstalarPlugin" Before="RemoveFiles">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
      <Custom Action="InstalarPlugin" Before="InstallFinalize">NOT REMOVE</Custom>
    </InstallExecuteSequence>

    <UIRef Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="licenca.rtf" />
  </Product>
</Wix>
